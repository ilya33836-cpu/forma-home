# Ключ Web3forms для статической сборки (GitHub Pages).
# Получить на https://web3forms.com — заявки приходят на почту.
# Нужен только для STATIC_BUILD=1; на Vercel работает свой /api/contact.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Канонический домен сайта. Без него на Vercel подставляется VERCEL_PROJECT_PRODUCTION_URL.
# NEXT_PUBLIC_SITE_URL=https://forma-home.ru

# Почта для формы заявки на серверном хостинге (Vercel).
# Без этих переменных заявки только логируются в консоль.
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
